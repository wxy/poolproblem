      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Content you deleted manually must be emptied by you in the Trash."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手动删除的内容需要用户自己在废纸篓里清空。"
          }
        }
      }
    },
    "trash.restore_consequence" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consequences of restoring"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "恢复的后果"
          }
        }
      }
    },
    "trash.restore_consequence_body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App batches are moved back to their original locations based on cleanup records, occupying space again; this only applies to items this app cleaned."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本应用批次按清理记录恢复到原始位置，恢复后重新占用空间；仅对应用清理过的条目有效。"
          }
        }
      }
    },
    "trash.restore_done" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restored %d app batch(es)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已恢复 %d 个本应用批次"
          }
        }
      }
    },

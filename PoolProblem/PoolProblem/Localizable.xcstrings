    "trash.why_manual_body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Trash is a safety staging area that gives you a chance to undo. The app never auto-cleans or restores it; emptying only affects app-created batches and never touches items you deleted manually."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "废纸篓是安全过渡区，给你挽回的机会。应用不会自动清理或恢复它；清空只作用于本应用批次，绝不会碰你手动删除的内容。"
          }
        }
      }
    },

      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This adds project dependencies and build output to the scan scope, then runs a full scan. Any later cleanup still requires confirmation and moves items to Trash."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加入后将项目依赖与构建产物纳入扫描范围，并立即运行完整扫描；日后清理仍需确认并移入废纸篓。"
          }
        }
      }
    },

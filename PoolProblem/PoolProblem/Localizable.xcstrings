    "explain.common" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "General app caches; apps regenerate them on demand and your data is unaffected."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用通用缓存，删除后应用会按需重新生成，不影响你的数据。"
          }
        }
      }
    },
    "explain.package_manager" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Package manager download caches; they re-download when needed and installed dependencies are unaffected."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "包管理器的下载缓存，删除后需要时会重新下载，不影响已安装的依赖。"
          }
        }
      }
    },
    "explain.project" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Project or custom directory; confirm nothing inside needs to be kept before cleaning."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "项目或自定义目录，删除前请确认其中没有需要保留的内容。"
          }
        }
      }
    },
    "explain.simulator" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simulator device data; it is recreated when needed. Make sure the simulator is quit before cleaning."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模拟器相关设备数据，删除后如需使用会重新创建；清理前请确认对应模拟器已退出。"
          }
        }
      }
    },
    "explain.xcode" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xcode build artifacts or test snapshots; they regenerate on the next build/test, so cleaning is safe."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "属于 Xcode 的构建产物或测试快照，删除后会在下次构建/测试时自动重新生成，因此可以安全清理。"
          }
        }
      }
    },

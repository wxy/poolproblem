    "candidate.preview_body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Directory: %@. This adds its project dependencies and build output to the scan scope and runs a full scan. Adding it does not delete files or authorize automatic permanent deletion. Any later cleanup requires your confirmation and moves items to Trash."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目录：%@。加入后将其项目依赖与构建产物纳入扫描范围，并立即运行完整扫描；这一步不会删除文件，也不会授权自动永久删除。未来如需清理，仍须你确认并移入废纸篓。"
          }
        }
      }
    },

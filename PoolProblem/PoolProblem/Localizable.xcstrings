    "trash.section_others" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Others (manually added)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",

    "cache.confirm_project" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move %@ (%@) to Trash? Xcode may re-index or rebuild this project and download dependencies again. The directory remains in Trash until you empty it."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将 %@（%@）移入废纸篓？Xcode 可能重新索引或编译该项目，并重新下载依赖。清空废纸篓前仍可恢复。"
          }
        }
      }
    },
    "cache.confirm_shared" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move %@ (%@) to Trash? This shared Xcode directory may cause multiple projects to rebuild. SourcePackages may need to download dependencies again. The directory remains in Trash until you empty it."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将 %@（%@）移入废纸篓？这是 Xcode 的共享目录，可能使多个项目重新编译；SourcePackages 还可能需要重新下载依赖。清空废纸篓前仍可恢复。"
          }
        }
      }
    },

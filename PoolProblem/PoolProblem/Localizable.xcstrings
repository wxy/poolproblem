    "cache.children_hint" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subdirectories currently using at least 10 MB. Open a name in Finder; cleaning moves only the selected directory to Trash."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "显示当前占用至少 10 MB 的一级目录。点击名称可在 Finder 中查看；清理只会将选中的目录移入废纸篓。"
          }
        }
      }
    },
    "cache.clean_child" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clean this subdirectory (to Trash)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清理该子目录（进回收站）"
          }
        }
      }
    },
    "cache.clean_failed" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not move the selected directory to Trash. Its state may have changed; the list has been refreshed."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未能将选中的目录移入废纸篓。目录状态可能已变化，列表已刷新。"

      }
    },
    "cache.confirm_cache" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move %@ (%@) to Trash? Only this directory is moved. You can restore it until you empty Trash."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将 %@（%@）移入废纸篓？只移动这个目录，清空废纸篓前可恢复。"
          }
        }
      }
    },
    "cache.confirm_move" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move to Trash"

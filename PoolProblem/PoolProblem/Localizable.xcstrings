    "trash.empty_consequence_body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App batches (regenerable caches/build products) are permanently deleted, freeing space immediately; this cannot be undone. Items you added manually are never touched."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本应用批次（来自可再生缓存/构建产物）会被永久删除，立即释放空间且不可恢复；你手动放入的内容不受影响。"
          }
        }
      }
    },
    "trash.empty_done" : {
      "localizations" : {
